#!/bin/zsh
# eepy: keep a MacBook awake with the lid closed while Claude Code works, then sleep it safely.

zmodload zsh/datetime zsh/system

VERSION=0.1.0

# ---- Defaults (owner-editable) ----
DEFAULT_FLOOR=20      # battery floor, percent
DEFAULT_UNPLUG=0      # 1 = treat "on battery" as a trigger
DEFAULT_LOWPOWER=0    # 1 = treat Low Power Mode as a trigger
GRACE=120             # seconds
INTERVAL=30           # seconds between checks

# ---- Safety constants: do not change ----
THERMAL_MAX=2         # OS thermal pressure "serious" or worse
TEMP_MAX=4000         # battery temperature, hundredths of a degree C
CAP=3600              # seconds of session inactivity before it stops counting
HEARTBEAT_MAX=90      # seconds before the watchdog distrusts the heartbeat
HOPS=20               # process-tree hops when looking for the Claude process

# ---- Claude Code facts (from the pre-flight probe) ----
CLAUDE_NAME=claude                # comm of the Claude Code process
RUNNING_STATUSES="running pending"  # background_tasks statuses that count as still running
HOOK_FORM=exec                    # exec: {"command": path, "args": ["hook"]}; anything else: {"command": "path hook"}

# ---- Paths ----
EEPY_HOME=${EEPY_HOME:-$HOME/.eepy}
EEPY_LOG=${EEPY_LOG:-$HOME/Library/Logs/eepy.log}
EEPY_PATH=${${(%):-%x}:A}

# ---- Loop state (epoch seconds; END=0 means no limit; LOCK_FD is set once this eepy holds the lock) ----
HOLDING=0 LAST_CHECK=0 LAST_ACTIVE=0 END=0 STOPPING= LAST_SUMMARY= ACTIVE=0 REPORT= LOCK_FD=

# ---- Readers: thin wrappers over macOS commands ----
read_lid() {
  local s=$(ioreg -r -k AppleClamshellState -d 1 2>/dev/null)
  case $s in
    *'"AppleClamshellState" = Yes'*) print closed ;;
    *'"AppleClamshellState" = No'*) print open ;;
    *) print '?' ;;
  esac
}

# Counts non-internal displays; never uses the IOMobileFramebufferShim flag (it reports 2 with no monitor).
read_displays() {
  local j total internal
  j=$(system_profiler SPDisplaysDataType -json 2>/dev/null) && [[ $j == *SPDisplaysDataType* ]] || { print '?'; return 0 }
  total=$(print -r -- $j | grep -c '"_spdisplays_displayID"')
  internal=$(print -r -- $j | grep -c '"spdisplays_connection_type" : "spdisplays_internal"')
  print $(( total - internal ))
}

read_attended() {
  local d=$(read_displays)
  [[ $(read_lid) == open ]] && { print 1; return 0 }
  [[ $d == <1-> ]] && print 1 || print 0
}

# 0 only when SleepDisabled is exactly No; unreadable counts as held.
read_held() {
  [[ $(ioreg -rn IOPMrootDomain -d 1 2>/dev/null) == *'"SleepDisabled" = No'* ]] && print 0 || print 1
}

read_os() {
  local s=$(osascript -l JavaScript -e 'var p=$.NSProcessInfo.processInfo; p.thermalState+" "+(p.isLowPowerModeEnabled?1:0)' 2>/dev/null)
  [[ $s == <->\ <0-1> ]] && print -r -- $s || print '? ?'
}

read_temp() {
  local t=$(ioreg -rn AppleSmartBattery 2>/dev/null | sed -n 's/^ *"Temperature" = \([0-9][0-9]*\) *$/\1/p' | head -1)
  print -r -- "${t:-?}"
}

read_batt() {
  local s=$(pmset -g batt 2>/dev/null) pct src
  [[ $s =~ '([0-9]+)%' ]] && pct=$match[1]
  case $s in
    *"'AC Power'"*) src=ac ;;
    *"'Battery Power'"*) src=battery ;;
  esac
  [[ -n $pct && -n $src ]] && print "$pct $src" || print '? ?'
}

# Prints one TRIGGER or FAILURE reason, or nothing. First matching rule wins.
trigger() {
  local th=$1 temp=$2 pct=$3 src=$4 lpm=$5
  [[ $th == '?' ]] && { print "FAILURE thermal pressure unreadable"; return 0 }
  [[ $temp == '?' ]] && { print "FAILURE battery temperature unreadable"; return 0 }
  [[ $pct == '?' ]] && { print "FAILURE battery level unreadable"; return 0 }
  [[ $src == '?' ]] && { print "FAILURE power source unreadable"; return 0 }
  [[ $lpm == '?' && $LOWPOWER == 1 ]] && { print "FAILURE Low Power Mode unreadable"; return 0 }
  (( th >= THERMAL_MAX )) && { print "TRIGGER heat: thermal pressure $th (limit $THERMAL_MAX)"; return 0 }
  (( temp >= TEMP_MAX )) && { printf 'TRIGGER battery temperature %d.%02d°C (limit 40.00°C)\n' $((temp/100)) $((temp%100)); return 0 }
  [[ $src == battery ]] && (( pct <= FLOOR )) && { print "TRIGGER battery $pct% (floor $FLOOR%)"; return 0 }
  [[ $UNPLUG == 1 && $src == battery ]] && { print "TRIGGER on battery (--unplug)"; return 0 }
  [[ $LOWPOWER == 1 && $lpm == 1 ]] && print "TRIGGER Low Power Mode on (--low-power)"
  return 0
}

# decide <holding> <attended> <want> <tripped> <gap> <timeup>: prints stop, pause, release, hold or stay.
decide() {
  local holding=$1 attended=$2 want=$3 tripped=$4 gap=$5 timeup=$6
  if (( timeup )); then print stop
  elif (( gap && !attended )); then print stop
  elif (( holding && tripped && !attended )); then print stop
  elif (( holding && tripped && attended )); then print pause
  elif (( holding && !want )); then print release
  elif (( !holding && want && !tripped && attended )); then print hold
  else print stay
  fi
}

usage() {
  cat <<'USAGE'
Commands:
  eepy                  hold while any Claude session is active, until stopped
  eepy 2h               same, for the next 2 hours only
  eepy --no-claude      hold until stopped, ignoring Claude
  eepy 2h --no-claude   hold for the next 2 hours, ignoring Claude
  eepy --battery 10     battery floor 10% (default 20%)
  eepy --unplug         also treat "on battery" as a trigger
  eepy --low-power      also treat Low Power Mode as a trigger
  eepy setup            one-time install
  eepy uninstall        undo everything setup did
  eepy hook             internal: called by Claude Code hooks
  eepy watchdog         internal: called by the LaunchAgent every minute
USAGE
}

now() { print -r -- $EPOCHSECONDS; }

log() {
  local line="$(date '+%F %T') $*"
  mkdir -p ${EEPY_LOG:h}
  print -r -- "$line" >> $EEPY_LOG
  # -u1 writes through a throwaway stream: a dead terminal leaves nothing buffered for later builtins to re-report.
  (( ${LOG_TTY:-0} == 1 )) && { print -u1 -r -- "$line" 2>/dev/null || true; }
  return 0
}

# Prints the process start time with spaces squeezed and trimmed, or nothing.
proc_start() {
  local s
  s=$(LC_ALL=C ps -o lstart= -p $1 2>/dev/null) || return 0
  print -r -- ${(j: :)${=s}}
}

# Nh, Nm or NhMm with a total above 0: prints seconds.
parse_duration() {
  [[ $1 =~ '^(([0-9]+)h)?(([0-9]+)m)?$' && -n $1 ]] || return 1
  local secs=$(( ${match[2]:-0} * 3600 + ${match[4]:-0} * 60 ))
  (( secs > 0 )) || return 1
  print -r -- $secs
}

# hook_next <json> <current>: prints "<state> <touch>" per the spec's Session tracking table.
hook_next() {
  local f ev tool nt run cron both
  f=$(print -r -- $1 | jq -r --arg st "$RUNNING_STATUSES" '
    ($st | split(" ")) as $L
    | [ (.hook_event_name // ""), (.tool_name // ""), (.notification_type // ""),
        ([(.background_tasks | arrays | .[] | select(.status | IN($L[])))] | length),
        ((.session_crons | arrays | length) // 0),
        ((.background_tasks | type) == "array" and (.session_crons | type) == "array") ]
    | map(tostring) | join("|")' 2>/dev/null) || { print "keep 0"; return 0 }
  IFS='|' read -r ev tool nt run cron both <<< $f
  case $ev in
    UserPromptSubmit|PostToolUse) print "working 1" ;;
    PreToolUse) [[ $tool == (AskUserQuestion|ExitPlanMode) ]] && print "finished 0" || print "keep 0" ;;
    Stop)
      if [[ $both == true ]] && (( run > 0 || cron > 0 )); then print "waiting 1"
      else print "finished 0"; fi ;;
    StopFailure) print "finished 0" ;;
    Notification)
      case $nt in
        permission_prompt|elicitation_dialog) print "finished 0" ;;
        idle_prompt) [[ $2 == working ]] && print "finished 0" || print "keep 0" ;;
        *) print "keep 0" ;;
      esac ;;
    SessionEnd) print "rm 0" ;;
    *) print "keep 0" ;;
  esac
}

# Prints the first pid at or above $1 in the process tree whose comm is CLAUDE_NAME, or nothing.
claude_pid() {
  local pid=$1 comm i
  for (( i = 0; i < HOPS; i++ )); do
    [[ $pid == <-> ]] && (( pid > 1 )) || return 0
    comm=$(ps -o comm= -p $pid 2>/dev/null) || return 0
    [[ ${comm:t} == $CLAUDE_NAME ]] && { print -r -- $pid; return 0 }
    pid=$(ps -o ppid= -p $pid 2>/dev/null) || return 0
    pid=${pid// /}
  done
  return 0
}

hook_run() {
  local json=$(cat) f id id8 ev both next state touch old act old_pid old_start pid start tmp
  local -a L
  f=$(print -r -- $json | jq -r '[(.session_id // ""), (.hook_event_name // ""),
    ((.background_tasks | type) == "array" and (.session_crons | type) == "array")] | map(tostring) | join("|")') || return 0
  IFS='|' read -r id ev both <<< $f
  [[ $id =~ '^[A-Za-z0-9_-]+$' ]] || return 0
  id8=${id[1,8]}
  pid=$(claude_pid $PPID)
  [[ -n $pid ]] || { log "hook $id8: no claude process found, ignored"; return 0 }
  f=$EEPY_HOME/sessions/$id
  old=""; act=""
  if [[ -r $f ]]; then
    L=("${(@f)$(<$f)}")
    old=$L[1] act=$L[2]
  fi
  next=$(hook_next "$json" "$old"); state=${next% *} touch=${next#* }
  [[ $ev == Stop && $both != true ]] && log "FAILURE hook $id8: Stop without task info"
  if [[ $state == rm ]]; then
    [[ -e $f ]] && { rm -f $f; log "hook $id8 $old -> removed ($ev)" }
    return 0
  fi
  [[ $state == keep ]] && return 0
  (( touch )) || [[ -z $act ]] && act=$(now)
  start=$(proc_start $pid)
  mkdir -p $EEPY_HOME/sessions || return 0
  tmp=$EEPY_HOME/.tmp.$id.$$
  print -r -- "$state"$'\n'"$act"$'\n'"$pid"$'\n'"$start" > $tmp && mv -f $tmp $f || { rm -f $tmp; return 0 }
  [[ $state != $old ]] && log "hook $id8 ${old:-none} -> $state ($ev)"
  return 0
}

# scan_sessions <now>: sets ACTIVE (count) and REPORT ("<id8> <state> <age>s, ..."). Deletes unparseable and mismatched files.
scan_sessions() {
  local now=$1 f id st act pid start age
  local -a L R
  ACTIVE=0 REPORT=""
  for f in $EEPY_HOME/sessions/*(N); do
    L=("${(@f)$(<$f 2>/dev/null)}")
    if (( $#L != 4 )) || [[ $L[1] != (working|waiting|finished) || $L[2] != <-> || $L[3] != <-> || -z $L[4] ]]; then
      rm -f $f; continue
    fi
    st=$L[1] act=$L[2] pid=$L[3] start=$L[4]
    [[ "$(proc_start $pid)" == "$start" ]] || { rm -f $f; continue }
    age=$(( now - act ))
    id=${f:t}; R+=("${id[1,8]} $st ${age}s")
    [[ $st != finished ]] && (( age >= 0 && age < CAP )) && (( ACTIVE++ ))
  done
  REPORT=${(j:, :)R}
}

# Never prints, never exits, always returns 0: Claude must not be affected by a bug here.
hook() {
  hook_run >/dev/null 2>&1
  return 0
}

# The only two functions that change the power setting. Callers re-read read_held; they never trust the return value.
hold() {
  local why
  mkdir -p $EEPY_HOME
  sudo -n /usr/bin/pmset -a disablesleep 1 2>$EEPY_HOME/err
  if [[ $(read_held) == 1 ]]; then
    log "hold: disablesleep 1, read back Yes"
    return 0
  fi
  why=$(<$EEPY_HOME/err 2>/dev/null)
  log "FAILURE hold failed: ${why:-read back No}"
  release
  return 1
}

release() {
  local ok=0 why
  mkdir -p $EEPY_HOME
  sudo -n /usr/bin/pmset -a disablesleep 0 2>$EEPY_HOME/err
  [[ $(read_held) == 0 ]] && ok=1
  if (( ok )); then
    log "release: disablesleep 0, read back No"
  else
    why=$(<$EEPY_HOME/err 2>/dev/null)
    log "FAILURE release failed: ${why:-read back Yes}"
  fi
  if [[ $(read_attended) == 0 ]]; then
    sudo -n /usr/bin/pmset sleepnow 2>/dev/null
    log "sleepnow (unattended)"
  fi
  (( ok )) && return 0
  return 1
}

# Run by the LaunchAgent: releases when sleep is disabled and the heartbeat is stale or missing.
watchdog() {
  local mt age=missing
  mt=$(stat -f %m $EEPY_HOME/heartbeat 2>/dev/null)
  [[ $mt == <-> ]] && age=$(( $(now) - mt ))
  [[ $age == missing ]] || (( age > HEARTBEAT_MAX )) || return 0
  [[ $(read_held) == 1 ]] || return 0
  [[ $age == missing ]] || age="${age}s old"
  log "FAILURE watchdog: heartbeat $age, sleep was disabled; releasing"
  release
}

# ---- Setup and uninstall ----
sudoers_text() {
  print -r -- "$1 ALL=(root) NOPASSWD: /usr/bin/pmset -a disablesleep 0, /usr/bin/pmset -a disablesleep 1, /usr/bin/pmset sleepnow"
}

agent_plist() {
  cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.eepy.watchdog</string>
  <key>ProgramArguments</key><array><string>$1</string><string>watchdog</string></array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>60</integer>
  <key>StandardErrorPath</key><string>$EEPY_HOME/watchdog.err</string>
</dict>
</plist>
PLIST
}

# JSON on stdin, JSON on stdout. Any jq error: returns 1 with no output.
merge_hooks() {
  local out
  out=$(jq --arg p "$1" --arg form "$HOOK_FORM" '
    (if $form == "exec" then {type: "command", command: $p, args: ["hook"]}
     else {type: "command", command: ($p + " hook")} end) as $h
    | def add($ev; $m): .hooks[$ev] += [(if $m == "" then {hooks: [$h]} else {matcher: $m, hooks: [$h]} end)];
    if type != "object" then error("not an object") else . end
    | (.hooks // {}) as $old
    | .hooks = ($old | map_values(map(.hooks |= map(select(((.command // "") | startswith($p)) | not)))
                                  | map(select((.hooks | length) > 0))))
    | add("UserPromptSubmit"; "") | add("PostToolUse"; "")
    | add("PreToolUse"; "AskUserQuestion|ExitPlanMode") | add("Stop"; "") | add("StopFailure"; "")
    | add("Notification"; "permission_prompt|elicitation_dialog|idle_prompt") | add("SessionEnd"; "")
  ' 2>/dev/null) || return 1
  print -r -- $out
}

unmerge_hooks() {
  local out
  out=$(jq --arg p "$1" '
    if type != "object" then error("not an object") else . end
    | if has("hooks") then
        .hooks |= map_values(map(.hooks |= map(select(((.command // "") | startswith($p)) | not)))
                             | map(select((.hooks | length) > 0))
                             | select(length > 0))
        | if (.hooks | length) == 0 then del(.hooks) else . end
      else . end
  ' 2>/dev/null) || return 1
  print -r -- $out
}

# 0 when no eepy holds the lock. The subshell drops the lock on exit.
lock_free() {
  mkdir -p $EEPY_HOME
  { : >> $EEPY_HOME/lock } 2>/dev/null || return 1
  ( zsystem flock -t 0 $EEPY_HOME/lock ) 2>/dev/null
}

setup_fail() {   # setup_fail <step number> <what failed>
  print -u2 "eepy setup failed at step $1: $2"
  (( $1 <= 2 )) && print -u2 "company security tooling may have blocked this; nothing else was changed"
  return 1
}

setup() {
  local me=$EEPY_PATH tmp args settings=$HOME/.claude/settings.json
  local plist=$HOME/Library/LaunchAgents/local.eepy.watchdog.plist
  local -a sets=("-a disablesleep 0" "-a disablesleep 1" "sleepnow")
  mkdir -p $EEPY_HOME || { setup_fail 1 "cannot create $EEPY_HOME"; return 1 }
  sudo -v || { setup_fail 1 "sudo -v"; return 1 }
  tmp=$(mktemp) || { setup_fail 2 "cannot make a temp file"; return 1 }
  sudoers_text $USER > $tmp
  /usr/sbin/visudo -cf $tmp >/dev/null 2>&1 || { rm -f $tmp; setup_fail 2 "the sudoers rule failed visudo's syntax check"; return 1 }
  sudo install -m 440 -o root -g wheel $tmp /etc/sudoers.d/eepy || { rm -f $tmp; setup_fail 2 "installing /etc/sudoers.d/eepy"; return 1 }
  rm -f $tmp
  for args in $sets; do
    sudo -k -n -l /usr/bin/pmset ${=args} >/dev/null 2>&1 || { setup_fail 2 "sudo does not accept 'pmset $args' without a password"; return 1 }
  done
  mkdir -p ${plist:h}
  agent_plist $me > $plist || { setup_fail 3 "writing $plist"; return 1 }
  launchctl bootout gui/$UID/local.eepy.watchdog >/dev/null 2>&1
  launchctl bootstrap gui/$UID $plist || { setup_fail 3 "launchctl bootstrap of the watchdog"; return 1 }
  mkdir -p $HOME/.local/bin
  ln -sf $me $HOME/.local/bin/eepy || { setup_fail 4 "linking ~/.local/bin/eepy"; return 1 }
  mkdir -p ${settings:h}
  local json='{}' merged backup=$settings.eepy-backup-$(now)
  if [[ -e $settings ]]; then
    cp $settings $backup || { setup_fail 5 "backing up settings.json"; return 1 }
    json=$(<$settings)
  else
    backup="(none, the file did not exist)"
  fi
  merged=$(print -r -- $json | merge_hooks $me) || { setup_fail 5 "settings.json is not valid JSON; it was not changed"; return 1 }
  tmp=$settings.eepy-tmp.$$
  print -r -- $merged > $tmp && mv -f $tmp $settings || { rm -f $tmp; setup_fail 5 "writing settings.json"; return 1 }
  print "eepy is set up:
  sudoers rule   /etc/sudoers.d/eepy
  watchdog       $plist
  command        ~/.local/bin/eepy -> $me
  hooks          merged into $settings (backup: $backup)
Start a new Claude Code session for the hooks to take effect, then run: eepy"
}

uninstall() {
  local me=$EEPY_PATH tmp json out backup settings=$HOME/.claude/settings.json
  local plist=$HOME/Library/LaunchAgents/local.eepy.watchdog.plist
  lock_free || { print -u2 "eepy is running; stop it first"; return 1 }
  sudo -v || { print -u2 "eepy uninstall: sudo -v failed; nothing was changed"; return 1 }
  [[ $(read_held) == 1 ]] && release
  if [[ -e $settings ]]; then
    backup=$settings.eepy-backup-$(now)
    cp $settings $backup || { print -u2 "eepy uninstall: cannot back up settings.json; stopped"; return 1 }
    out=$(unmerge_hooks $me < $settings) || { print -u2 "eepy uninstall: settings.json is not valid JSON; stopped"; return 1 }
    tmp=$settings.eepy-tmp.$$
    print -r -- $out > $tmp && mv -f $tmp $settings || { rm -f $tmp; print -u2 "eepy uninstall: cannot write settings.json; stopped"; return 1 }
  fi
  rm -f $HOME/.local/bin/eepy
  sudo rm -f /etc/sudoers.d/eepy || { print -u2 "eepy uninstall: cannot remove /etc/sudoers.d/eepy; stopped"; return 1 }
  launchctl bootout gui/$UID/local.eepy.watchdog >/dev/null 2>&1
  rm -f $plist
  rm -rf $EEPY_HOME
  print "eepy is uninstalled. The log is kept at $EEPY_LOG${backup:+, and settings.json was backed up to $backup}."
}

# One pass of the spec's Behaviour. Returns 0 to carry on, 1 once eepy has stopped and released.
check_once() {
  local t prev elapsed gap=0 want=0 timeup=0 tripped=0 attended th lpm temp pct src reason tc s
  t=$(now)
  touch $EEPY_HOME/heartbeat
  prev=$HOLDING; HOLDING=$(read_held)
  if (( !prev && HOLDING )) && [[ $(read_attended) == 0 ]]; then   # never adopt a hold while unattended
    log "FAILURE expected holding=0, SleepDisabled says 1 while unattended; releasing"
    release; HOLDING=$(read_held)
  elif [[ $prev != $HOLDING ]]; then
    log "FAILURE expected holding=$prev, SleepDisabled says $HOLDING; following SleepDisabled"
  fi
  if [[ -n $STOPPING ]]; then
    release; HOLDING=$(read_held)
    (( HOLDING )) && return 0
    return 1
  fi
  elapsed=$(( t - LAST_CHECK ))
  (( prev == 1 && LAST_CHECK > 0 && elapsed > 3 * INTERVAL )) && gap=1
  LAST_CHECK=$t
  attended=$(read_attended)
  read -r th lpm <<< $(read_os)
  temp=$(read_temp)
  read -r pct src <<< $(read_batt)
  (( NOCLAUDE )) || scan_sessions $t
  if (( NOCLAUDE )); then want=1
  elif (( ACTIVE > 0 )); then want=1 LAST_ACTIVE=$t
  elif (( LAST_ACTIVE > 0 && t - LAST_ACTIVE < GRACE )); then want=1
  fi
  (( END > 0 && t >= END )) && timeup=1
  reason=$(trigger $th $temp $pct $src $lpm)
  [[ -n $reason ]] && tripped=1
  case $(decide $HOLDING $attended $want $tripped $gap $timeup) in
    hold) hold; HOLDING=$(read_held) ;;
    release) log "released: no active sessions"; release; HOLDING=$(read_held) ;;
    pause) log "$reason (attended: released, not sleeping)"; release; HOLDING=$(read_held) ;;
    stop)
      if (( timeup )); then STOPPING="TRIGGER time limit reached"
      elif (( gap )); then STOPPING="FAILURE gap: no check for ${elapsed}s while holding"
      else STOPPING=$reason
      fi
      log $STOPPING; release; HOLDING=$(read_held)
      (( HOLDING )) && return 0
      return 1 ;;
  esac
  if (( HOLDING )); then
    tc='?'; [[ $temp == <-> ]] && printf -v tc '%d.%02d' $((temp / 100)) $((temp % 100))
    log "attended=$attended thermal=$th temp=${tc}°C batt=$pct% $src lpm=$lpm sessions: $REPORT"
  else
    s="attended=$attended active=$ACTIVE"
    [[ $s != $LAST_SUMMARY ]] && log $s
    LAST_SUMMARY=$s
  fi
  return 0
}

run() {
  trap on_signal INT TERM HUP QUIT
  trap '' TSTP PIPE
  mkdir -p $EEPY_HOME/sessions 2>/dev/null || { print -u2 "cannot create $EEPY_HOME/sessions"; return 1 }
  { : >> $EEPY_HOME/lock } 2>/dev/null || { print -u2 "cannot create $EEPY_HOME/lock"; return 1 }
  zsystem flock -t 0 -f LOCK_FD $EEPY_HOME/lock 2>/dev/null || { print -u2 "eepy is already running"; return 1 }
  sudo -k -n -l /usr/bin/pmset -a disablesleep 0 >/dev/null 2>&1 &&
    sudo -k -n -l /usr/bin/pmset -a disablesleep 1 >/dev/null 2>&1 &&
    sudo -k -n -l /usr/bin/pmset sleepnow >/dev/null 2>&1 || { print -u2 'run "eepy setup" first'; return 1 }
  launchctl print gui/$UID/local.eepy.watchdog >/dev/null 2>&1 ||
    { print -u2 'the eepy watchdog is not loaded; run "eepy setup"'; return 1 }
  LOG_TTY=1
  log "start: eepy $VERSION limit=${LIMIT}s no-claude=$NOCLAUDE battery-floor=$FLOOR% unplug=$UNPLUG low-power=$LOWPOWER" \
    "grace=${GRACE}s interval=${INTERVAL}s thermal-max=$THERMAL_MAX temp-max=$TEMP_MAX cap=${CAP}s" \
    "heartbeat-max=${HEARTBEAT_MAX}s hops=$HOPS"
  (( LIMIT > 0 )) && END=$(( $(now) + LIMIT ))
  HOLDING=$(read_held)
  (( HOLDING )) && log "FAILURE sleep was already disabled at start; taking it over"
  while check_once; do sleep $INTERVAL & wait $!; done
  return 0
}

on_signal() {
  [[ -n $LOCK_FD ]] || exit 0   # not holding the lock: any hold belongs to another eepy
  trap '' INT TERM HUP QUIT
  release
  log "stopped by signal"
  kill %sleep 2>/dev/null   # zsh defers exit inside a function, and `wait` would sit out the whole sleep
  exit 0
}

parse_args() {
  CMD=run LIMIT=0 NOCLAUDE=0
  FLOOR=$DEFAULT_FLOOR UNPLUG=$DEFAULT_UNPLUG LOWPOWER=$DEFAULT_LOWPOWER
  local secs
  while (( $# )); do
    case $1 in
      setup|uninstall|hook|watchdog) CMD=$1 ;;
      --no-claude) NOCLAUDE=1 ;;
      --unplug) UNPLUG=1 ;;
      --low-power) LOWPOWER=1 ;;
      --battery)
        [[ $2 == <1-99> ]] || { usage >&2; return 1 }
        FLOOR=$2; shift ;;
      *)
        secs=$(parse_duration "$1") || { usage >&2; return 1 }
        LIMIT=$secs ;;
    esac
    shift
  done
}

main() {
  parse_args "$@" || exit 1
  local rc=0
  case $CMD in
    hook) hook ;;  # always 0, never prints
    run) run || rc=1 ;;
    watchdog) watchdog ;;
    setup) setup || rc=1 ;;
    uninstall) uninstall || rc=1 ;;
    *) print -u2 "eepy $CMD: not built yet"; rc=1 ;;
  esac
  exit $rc
}

[[ $ZSH_EVAL_CONTEXT == toplevel ]] && main "$@"
