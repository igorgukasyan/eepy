#!/bin/zsh
# eepy: keep a MacBook awake with the lid closed while Claude Code works, then sleep it safely.

zmodload zsh/datetime zsh/system

# ---- Defaults (owner-editable) ----
DEFAULT_FLOOR=20      # battery floor, percent
DEFAULT_UNPLUG=0      # 1 = treat "on battery" as a trigger
DEFAULT_LOWPOWER=0    # 1 = treat Low Power Mode as a trigger
GRACE=120             # seconds
INTERVAL=30           # seconds between checks

# ---- Safety constants: do not change ----
THERMAL_MAX=2         # OS thermal pressure "serious" or worse
TEMP_MAX=4000         # battery temperature, hundredths of a degree C
CAP=3600              # seconds of session inactivity before it stops counting
HEARTBEAT_MAX=90      # seconds before the watchdog distrusts the heartbeat
HOPS=20               # process-tree hops when looking for the Claude process

# ---- Paths ----
EEPY_HOME=${EEPY_HOME:-$HOME/.eepy}
EEPY_LOG=${EEPY_LOG:-$HOME/Library/Logs/eepy.log}

# ---- Readers: thin wrappers over macOS commands ----
read_lid() {
  local s=$(ioreg -r -k AppleClamshellState -d 1 2>/dev/null)
  case $s in
    *'"AppleClamshellState" = Yes'*) print closed ;;
    *'"AppleClamshellState" = No'*) print open ;;
    *) print '?' ;;
  esac
}

# Counts non-internal displays; never uses the IOMobileFramebufferShim flag (it reports 2 with no monitor).
read_displays() {
  local j total internal
  j=$(system_profiler SPDisplaysDataType -json 2>/dev/null) && [[ $j == *SPDisplaysDataType* ]] || { print '?'; return 0 }
  total=$(print -r -- $j | grep -c '"_spdisplays_displayID"')
  internal=$(print -r -- $j | grep -c '"spdisplays_connection_type" : "spdisplays_internal"')
  print $(( total - internal ))
}

read_attended() {
  local d=$(read_displays)
  [[ $(read_lid) == open ]] && { print 1; return 0 }
  [[ $d == <1-> ]] && print 1 || print 0
}

# 0 only when SleepDisabled is exactly No; unreadable counts as held.
read_held() {
  [[ $(ioreg -rn IOPMrootDomain -d 1 2>/dev/null) == *'"SleepDisabled" = No'* ]] && print 0 || print 1
}

read_os() {
  local s=$(osascript -l JavaScript -e 'var p=$.NSProcessInfo.processInfo; p.thermalState+" "+(p.isLowPowerModeEnabled?1:0)' 2>/dev/null)
  [[ $s == <->\ <0-1> ]] && print -r -- $s || print '? ?'
}

read_temp() {
  local t=$(ioreg -rn AppleSmartBattery 2>/dev/null | sed -n 's/^ *"Temperature" = \([0-9][0-9]*\) *$/\1/p' | head -1)
  print -r -- "${t:-?}"
}

read_batt() {
  local s=$(pmset -g batt 2>/dev/null) pct src
  [[ $s =~ '([0-9]+)%' ]] && pct=$match[1]
  case $s in
    *"'AC Power'"*) src=ac ;;
    *"'Battery Power'"*) src=battery ;;
  esac
  [[ -n $pct && -n $src ]] && print "$pct $src" || print '? ?'
}

# Prints one TRIGGER or FAILURE reason, or nothing. First matching rule wins.
trigger() {
  local th=$1 temp=$2 pct=$3 src=$4 lpm=$5
  [[ $th == '?' ]] && { print "FAILURE thermal pressure unreadable"; return 0 }
  [[ $temp == '?' ]] && { print "FAILURE battery temperature unreadable"; return 0 }
  [[ $pct == '?' ]] && { print "FAILURE battery level unreadable"; return 0 }
  [[ $src == '?' ]] && { print "FAILURE power source unreadable"; return 0 }
  [[ $lpm == '?' && $LOWPOWER == 1 ]] && { print "FAILURE Low Power Mode unreadable"; return 0 }
  (( th >= THERMAL_MAX )) && { print "TRIGGER heat: thermal pressure $th (limit $THERMAL_MAX)"; return 0 }
  (( temp >= TEMP_MAX )) && { printf 'TRIGGER battery temperature %d.%02d°C (limit 40.00°C)\n' $((temp/100)) $((temp%100)); return 0 }
  [[ $src == battery ]] && (( pct <= FLOOR )) && { print "TRIGGER battery $pct% (floor $FLOOR%)"; return 0 }
  [[ $UNPLUG == 1 && $src == battery ]] && { print "TRIGGER on battery (--unplug)"; return 0 }
  [[ $LOWPOWER == 1 && $lpm == 1 ]] && print "TRIGGER Low Power Mode on (--low-power)"
  return 0
}

# decide <holding> <attended> <want> <tripped> <gap> <timeup>: prints stop, pause, release, hold or stay.
decide() {
  local holding=$1 attended=$2 want=$3 tripped=$4 gap=$5 timeup=$6
  if (( timeup )); then print stop
  elif (( gap && !attended )); then print stop
  elif (( holding && tripped && !attended )); then print stop
  elif (( holding && tripped && attended )); then print pause
  elif (( holding && !want )); then print release
  elif (( !holding && want && !tripped && attended )); then print hold
  else print stay
  fi
}

usage() {
  cat <<'USAGE'
Commands:
  eepy                  hold while any Claude session is active, until stopped
  eepy 2h               same, for the next 2 hours only
  eepy --no-claude      hold until stopped, ignoring Claude
  eepy 2h --no-claude   hold for the next 2 hours, ignoring Claude
  eepy --battery 10     battery floor 10% (default 20%)
  eepy --unplug         also treat "on battery" as a trigger
  eepy --low-power      also treat Low Power Mode as a trigger
  eepy setup            one-time install
  eepy uninstall        undo everything setup did
  eepy hook             internal: called by Claude Code hooks
  eepy watchdog         internal: called by the LaunchAgent every minute
USAGE
}

now() { print -r -- $EPOCHSECONDS; }

log() {
  local line="$(date '+%F %T') $*"
  mkdir -p ${EEPY_LOG:h}
  print -r -- "$line" >> $EEPY_LOG
  (( ${LOG_TTY:-0} == 1 )) && { print -r -- "$line" 2>/dev/null || true; }
  return 0
}

# Prints the process start time with spaces squeezed and trimmed, or nothing.
proc_start() {
  local s
  s=$(LC_ALL=C ps -o lstart= -p $1 2>/dev/null) || return 0
  print -r -- ${(j: :)${=s}}
}

# Nh, Nm or NhMm with a total above 0: prints seconds.
parse_duration() {
  [[ $1 =~ '^(([0-9]+)h)?(([0-9]+)m)?$' && -n $1 ]] || return 1
  local secs=$(( ${match[2]:-0} * 3600 + ${match[4]:-0} * 60 ))
  (( secs > 0 )) || return 1
  print -r -- $secs
}

parse_args() {
  CMD=run LIMIT=0 NOCLAUDE=0
  FLOOR=$DEFAULT_FLOOR UNPLUG=$DEFAULT_UNPLUG LOWPOWER=$DEFAULT_LOWPOWER
  local secs
  while (( $# )); do
    case $1 in
      setup|uninstall|hook|watchdog) CMD=$1 ;;
      --no-claude) NOCLAUDE=1 ;;
      --unplug) UNPLUG=1 ;;
      --low-power) LOWPOWER=1 ;;
      --battery)
        [[ $2 == <1-99> ]] || { usage >&2; return 1 }
        FLOOR=$2; shift ;;
      *)
        secs=$(parse_duration "$1") || { usage >&2; return 1 }
        LIMIT=$secs ;;
    esac
    shift
  done
}

main() {
  parse_args "$@" || exit 1
  local rc=0
  case $CMD in
    hook) exit 0 ;;  # always 0, never prints
    *) print -u2 "eepy $CMD: not built yet"; rc=1 ;;
  esac
  exit $rc
}

[[ $ZSH_EVAL_CONTEXT == toplevel ]] && main "$@"
